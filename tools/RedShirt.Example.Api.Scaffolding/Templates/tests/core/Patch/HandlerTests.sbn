{{~ n = model.name; req = model.patch_request.name ~}}
{{ usings (["Moq", model.core_namespace + ".Cqrs", model.use_case_namespace + ".Commands.Patch", model.service_namespace, model.dto_namespace, model.patch_request.namespace] | array.add_range model.patch_namespaces) }}namespace {{ model.core_namespace }}.UnitTests.Tests.UseCases.{{ model.name }}.Commands.Patch;

/// <summary>
///     Scaffolded by scripts/scaffold.sh.
/// </summary>
public class Patch{{ n }}CommandHandlerTests
{
    [Fact]
    public async Task Handle_ValidatesAndMapsCommandToPatchRequest()
    {
        var expected = {{ n }}TestData.CreateDto();
        {{ req }}? capturedRequest = null;
        var service = new Mock<{{ model.service_interface }}>();
        service
            .Setup(s => s.PatchAsync(It.IsAny<{{ req }}>(), It.IsAny<CancellationToken>()))
            .Callback<{{ req }}, CancellationToken>((request, _) => capturedRequest = request)
            .ReturnsAsync(expected);
        var validator = new Mock<ICoreRequestValidator>();
        var handler = new Patch{{ n }}CommandHandler(service.Object, validator.Object);
        var command = new Patch{{ n }}Command(
            {{ model.key.sample_value }}{{ if model.patch_properties.size == 0 }});{{ else }},{{ end }}
{{~ for p in model.patch_properties ~}}
            {{ p.sample_value }}{{ if for.last }});{{ else }},{{ end }}
{{~ end ~}}

        var result = await handler.Handle(command, TestContext.Current.CancellationToken);

        Assert.Same(expected, result);
        Assert.NotNull(capturedRequest);
        Assert.Equal(command.{{ model.key.name }}, capturedRequest.{{ model.key.name }});
{{~ for p in model.patch_properties ~}}
        Assert.Equal(command.{{ p.name }}, capturedRequest.{{ p.name }});
{{~ end ~}}
        validator.Verify(v => v.ValidateAsync(command, TestContext.Current.CancellationToken), Times.Once);
    }
}
