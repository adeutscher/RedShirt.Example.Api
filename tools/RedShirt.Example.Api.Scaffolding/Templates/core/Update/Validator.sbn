using FluentValidation;

namespace {{ model.use_case_namespace }}.Commands.Update;

public class Update{{ model.name }}CommandValidator : AbstractValidator<Update{{ model.name }}Command>
{
{{~ if model.put_required_strings.size > 0 ~}}
    public Update{{ model.name }}CommandValidator()
    {
{{~ for p in model.put_required_strings ~}}
{{~ if !for.first ~}}

{{~ end ~}}
        RuleFor(command => command.{{ p.name }})
            .Must({{ p.camel_name }} => !string.IsNullOrWhiteSpace({{ p.camel_name }}))
            .WithMessage("'{{ p.name }}' must not be empty.");
{{~ end ~}}
    }
{{~ end ~}}
}
