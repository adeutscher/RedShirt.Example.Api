{
  "realm": "example",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": false,
  "roles": {
    "realm": [
      {
        "name": "developer",
        "description": "Full API access; still subject to customer resource scope",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "admin",
        "description": "Full API access; bypasses customer resource scope; composite includes developer",
        "composite": true,
        "composites": {
          "realm": [
            "developer"
          ]
        },
        "clientRole": false
      },
      {
        "name": "analyst",
        "description": "Read-only access to Product",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "billing",
        "description": "Read-write access to Order",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "upload-validator",
        "description": "Upload validation worker: GET upload by id, verdicts, move reports",
        "composite": false,
        "clientRole": false
      }
    ]
  },
  "users": [
    {
      "username": "testuser",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Test",
      "lastName": "User",
      "email": "testuser@example.local",
      "credentials": [
        {
          "type": "password",
          "value": "testpass",
          "temporary": false
        }
      ],
      "realmRoles": [
        "admin"
      ]
    },
    {
      "username": "developeruser",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Developer",
      "lastName": "User",
      "email": "developeruser@example.local",
      "credentials": [
        {
          "type": "password",
          "value": "developerpass",
          "temporary": false
        }
      ],
      "attributes": {
        "customer_id": [
          "11111111-1111-1111-1111-111111111111"
        ]
      },
      "realmRoles": [
        "developer"
      ]
    },
    {
      "username": "analystuser",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Analyst",
      "lastName": "User",
      "email": "analystuser@example.local",
      "credentials": [
        {
          "type": "password",
          "value": "analystpass",
          "temporary": false
        }
      ],
      "realmRoles": [
        "analyst"
      ]
    },
    {
      "username": "billinguser",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Billing",
      "lastName": "User",
      "email": "billinguser@example.local",
      "credentials": [
        {
          "type": "password",
          "value": "billingpass",
          "temporary": false
        }
      ],
      "attributes": {
        "customer_id": [
          "11111111-1111-1111-1111-111111111111"
        ]
      },
      "realmRoles": [
        "billing"
      ]
    },
    {
      "username": "uploadvalidator",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Upload",
      "lastName": "Validator",
      "email": "uploadvalidator@example.local",
      "credentials": [
        {
          "type": "password",
          "value": "uploadvalidatorpass",
          "temporary": false
        }
      ],
      "realmRoles": [
        "upload-validator"
      ]
    },
    {
      "username": "service-account-example-service",
      "enabled": true,
      "serviceAccountClientId": "example-service",
      "clientRoles": {},
      "realmRoles": [
        "admin"
      ]
    }
  ],
  "clients": [
    {
      "clientId": "example-api",
      "name": "Example API (local)",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "fullScopeAllowed": true,
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "basic",
        "profile",
        "roles",
        "email"
      ],
      "optionalClientScopes": [
        "address",
        "phone",
        "offline_access",
        "microprofile-jwt"
      ],
      "protocolMappers": [
        {
          "name": "audience-example-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "example-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "realm-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "userinfo.token.claim": "true",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "claim.name": "role",
            "jsonType.label": "String"
          }
        },
        {
          "name": "customer-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "false",
            "user.attribute": "customer_id",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "claim.name": "customer_id",
            "jsonType.label": "String"
          }
        }
      ]
    },
    {
      "clientId": "example-service",
      "name": "Example service account (local)",
      "enabled": true,
      "publicClient": false,
      "secret": "example-service-secret",
      "directAccessGrantsEnabled": false,
      "standardFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "protocol": "openid-connect",
      "fullScopeAllowed": true,
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "basic",
        "profile",
        "roles",
        "email"
      ],
      "protocolMappers": [
        {
          "name": "audience-example-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "example-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "realm-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "userinfo.token.claim": "true",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "claim.name": "role",
            "jsonType.label": "String"
          }
        },
        {
          "name": "customer-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "false",
            "user.attribute": "customer_id",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "claim.name": "customer_id",
            "jsonType.label": "String"
          }
        }
      ]
    }
  ]
}
