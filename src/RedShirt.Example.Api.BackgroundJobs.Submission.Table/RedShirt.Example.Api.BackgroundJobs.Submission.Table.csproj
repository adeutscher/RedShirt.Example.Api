<Project Sdk="Microsoft.NET.Sdk">

    <!--
        The IBackgroundJobSubmitter that writes jobs to the BackgroundJob table for the in-API runner. To hand jobs to an
        applied JobWorker instead, register a submitter that publishes to its queue (for example from a sibling
        BackgroundJobs.Submission.<Queue> project) in place of this one.
    -->

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.13"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\RedShirt.Example.Api.BackgroundJobs.Core\RedShirt.Example.Api.BackgroundJobs.Core.csproj"/>
        <ProjectReference Include="..\RedShirt.Example.Api.BackgroundJobs.Submission\RedShirt.Example.Api.BackgroundJobs.Submission.csproj"/>
        <ProjectReference Include="..\RedShirt.Example.Api.DataStores.BackgroundJob.Core\RedShirt.Example.Api.DataStores.BackgroundJob.Core.csproj"/>
    </ItemGroup>

</Project>
