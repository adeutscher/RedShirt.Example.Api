<Project Sdk="Microsoft.NET.Sdk">

    <!--
        The BackgroundJob table's contract. The table stays whether jobs are run inside the API or by an applied JobWorker,
        so this project depends only on the submission contract, never on the projects that process jobs.
    -->

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\RedShirt.Example.Api.BackgroundJobs.Submission.Core\RedShirt.Example.Api.BackgroundJobs.Submission.Core.csproj"/>
    </ItemGroup>

</Project>
