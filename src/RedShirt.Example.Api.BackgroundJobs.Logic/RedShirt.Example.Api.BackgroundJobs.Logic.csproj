<Project Sdk="Microsoft.NET.Sdk">

    <!--
        Job logic. This project references only the background job shapes, so it can move into an applied JobWorker's
        Core.Logic project. The services that a handler calls back into (such as IUploadValidationService) are
        interfaces here: the API implements them with CQRS handlers, and a JobWorker would implement them with connectors.
    -->

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.13"/>
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\RedShirt.Example.Api.BackgroundJobs.Core\RedShirt.Example.Api.BackgroundJobs.Core.csproj"/>
    </ItemGroup>

</Project>
