<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.1</TargetFramework>
        <LangVersion>12</LangVersion>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="NSwag.MSBuild" Version="14.7.1">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="System.ComponentModel.Annotations" Version="5.0.0"/>
        <PackageReference Include="System.Text.Json" Version="10.0.11"/>
    </ItemGroup>

    <Target Name="NSwag"
            BeforeTargets="CoreCompile"
            Inputs="swagger.json;nswag.json"
            Outputs="Client.generated.cs">
        <Exec Command="$(NSwagExe_Net100) run nswag.json"
              WorkingDirectory="$(MSBuildProjectDirectory)"/>
    </Target>

</Project>
