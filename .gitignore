# Common IntelliJ Platform excludes

.idea/
# User specific
**/.idea/**/workspace.xml
**/.idea/**/tasks.xml
**/.idea/shelf/*
**/.idea/dictionaries
**/.idea/httpRequests/

# Sensitive or high-churn files
**/.idea/**/dataSources/
**/.idea/**/dataSources.ids
**/.idea/**/dataSources.xml
**/.idea/**/dataSources.local.xml
**/.idea/**/sqlDataSources.xml
**/.idea/**/dynamic.xml

# Rider
# Rider auto-generates .iml files, and contentModel.xml
**/.idea/**/*.iml
**/.idea/**/contentModel.xml
**/.idea/**/modules.xml

*.suo
*.user
*.rsuser
.vs/
[Bb]in/
[Oo]bj/
_UpgradeReport_Files/
[Pp]ackages/
*.nupkg
*.snupkg
artifacts/
[Tt]est[Rr]esults/
**/coverage*
*.coverage
*.coveragexml
**/BenchmarkDotNet.Artifacts/

.env
.env.*
appsettings.*.local.json

# Local Docker persistence
test/local/data/mariadb-data/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
ENV/

Thumbs.db
Desktop.ini
.DS_Store

*.generated.cs

# Vim Swapfiles
.*.swp

# Generic logs
*.log

# Just in case anyone took the test/local/ documentation very literally:
**/RedShirt.Example.Schema

# Local benchmarks
.bench/

# Cursor / editor artifacts (.cursor/rules/ is tracked intentionally)
.vscode/
.specstory/
.history/
.cursorrules
.cursor-chat-history/
.cursor/chats/
.cursor/logs/
.cursor/session*
.agents/
.claude/
.codex/
